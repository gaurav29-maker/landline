# Postgres.
#
# Production: Neon or Supabase, using the pooled connection string.
#   DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
#
# Development: `npm run db:local` starts a real Postgres locally with nothing
# to install and no account — it is Postgres compiled to WebAssembly behind
# the ordinary wire protocol. Then use:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"

# Razorpay. PHASE 1 USES TEST KEYS ONLY - they start rzp_test_.
# Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=""
# Dashboard > Settings > Webhooks. This is NOT the key secret.
RAZORPAY_WEBHOOK_SECRET=""
# Same value as RAZORPAY_KEY_ID; exposed to the browser for Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# Resend. In phase 1, point every address at your own inbox.
RESEND_API_KEY=""
EMAIL_FROM="Landline <bookings@example.com>"
EMAIL_REPLY_TO="you@example.com"

# Signing secret for intake magic links. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=""

# SMS, for the sign-in code. LEAVE BLANK UNTIL DLT IS DONE.
#
# Sending a text to an Indian number needs three registrations on a
# telecom DLT platform first, in this order, and none can be skipped:
#   1. the entity   - PAN, GST, business proof. Needs the company to exist.
#   2. the header   - a six-character sender ID, e.g. LNDLNE. A sign-in
#                     code must go out on a TRANSACTIONAL header.
#   3. the template - the exact message body with {#var#} slots, approved
#                     one at a time, each issued a template id. What is
#                     sent must match what was approved, word for word.
#
# Operators drop unregistered traffic, and there is no test mode that
# reaches a real handset. Until then, leave SMS_PROVIDER unset: a dev
# server prints the code to its own console and sign-in works end to end.
# Setting SMS_PROVIDER without wiring the call in lib/sms.ts throws.
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_TEMPLATE_SIGNIN=""

# Cloudflare Turnstile, the human check in front of the code request.
# Optional: with no secret the widget is not drawn and the check passes,
# which is how development and the suite run. Set BOTH or NEITHER — a
# site key with no secret is a widget that proves nothing while looking
# like it does. Dashboard > Turnstile > Add site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Guards the Vercel Cron endpoints.
CRON_SECRET=""

# The single password for the ops console at /ops. If this is unset the
# console refuses everyone, which is the safe default.
OPS_PASSWORD=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
